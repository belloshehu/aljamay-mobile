{
  "name": "Aljamay",
  "slug": "aljamay",
  "scheme": "aljamay",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "icon": "./assets/images/aljamay-logo.png",
  "updates": {
    "fallbackToCacheTimeout": 0,
    "url": "https://u.expo.dev/a5face2e-e735-4b44-b488-2767aad09b7a"
  },
  "newArchEnabled": true,
  "jsEngine": "hermes",
  "assetBundlePatterns": ["**/*"],
  "android": {
    "icon": "./assets/images/app-icon-android-legacy.png",
    "package": "com.belloshehu.Aljamay",
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/app-icon-android-adaptive-foreground.png",
      "backgroundColor": "#FFFFFF"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ADF802"
    },
    "allowBackup": false,
    "edgeToEdgeEnabled": true,
    "permissions": ["android.permission.RECORD_AUDIO"]
  },
  "ios": {
    "icon": "./assets/images/app-icon-ios.png",
    "supportsTablet": true,
    "bundleIdentifier": "com.belloshehu.Aljamay",
    "privacyManifests": {
      "NSPrivacyAccessedAPITypes": [
        {
          "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
          "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
        }
      ]
    }
  },
  "web": {
    "favicon": "./assets/images/app-icon-web-favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow access to your photos",
        "cameraPermission": "Allow access to your camera"
      }
    ],
    "expo-localization",
    "expo-font",
    "expo-router",
    "expo-secure-store",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/app-icon-android-adaptive-foreground.png",
        "imageWidth": 300,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    ],
    [
      "react-native-edge-to-edge",
      {
        "android": {
          "parentTheme": "Light",
          "enforceNavigationBarContrast": false
        }
      }
    ],
    "expo-build-properties"
  ],
  "experiments": {
    "tsconfigPaths": true,
    "typedRoutes": true
  },
  "extra": {
    "ignite": {
      "version": "UNKNOWN"
    },
    "router": {},
    "eas": {
      "projectId": "1bd62e20-dfd7-4372-be00-f140314cfbd0"
    }
  },
  "runtimeVersion": {
    "policy": "appVersion"
  }
}
